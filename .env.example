# Copy this file to .env for local development.
# All Palanaeum environment variables use the PALA_ prefix.

# Core & Security
PALA_DEBUG=True
# Required when PALA_DEBUG=False
PALA_SECRET_KEY=change-me-in-production
# Comma-separated hostnames (defaults to localhost,127.0.0.1 when PALA_DEBUG=True)
PALA_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins with scheme, e.g. https://wob.coppermind.net
PALA_CSRF_TRUSTED_ORIGINS=
PALA_DEV_SERVER_ADDR=127.0.0.1:9000
# Comma-separated IPs for django-debug-toolbar (only used when PALA_DEBUG=True)
PALA_INTERNAL_IPS=127.0.0.1

# Theme & App
# One of: blue, green, pink
PALA_STYLE=blue
PALA_SITE_ID=1
PALA_TINYMCE_API_KEY=
PALA_CORS_ALLOW_ALL=True

# PostgreSQL
PALA_DB_HOST=127.0.0.1
PALA_DB_PORT=5432
PALA_DB_NAME=palanaeum
PALA_DB_USER=palanaeum
PALA_DB_PASSWORD=

# Redis, Celery & Cache
PALA_REDIS_HOST=127.0.0.1
PALA_REDIS_PORT=6379
PALA_REDIS_DB=0
# One of: dummy, redis
PALA_CACHE_CONFIG=dummy

# Storage paths (optional; defaults are relative to repo root / /tmp)
# PALA_MEDIA_ROOT=
# PALA_BACKUP_DIR=
# PALA_UPLOAD_DIRECTORY=/tmp/palanaeum_uploads/done/
# PALA_CHUNKS_DIRECTORY=/tmp/palanaeum_uploads/chunks/

# Logging
# PALA_DJANGO_LOG_LEVEL=INFO
# PALA_LOG_LEVEL=INFO

# Admins & Email
# Comma-separated list of admin email addresses
PALA_ADMINS=
# Leaving PALA_EMAIL_HOST empty defaults to Django's console email backend
PALA_EMAIL_HOST=
PALA_EMAIL_PORT=587
PALA_EMAIL_USER=
PALA_EMAIL_PASSWORD=
PALA_EMAIL_USE_TLS=True
PALA_EMAIL_FROM=palanaeum@mestiv.dev
PALA_EMAIL_SERVER=pala-root@mestiv.dev
PALA_EMAIL_PREFIX=[Palanaeum]
# Optional explicit override, e.g. django.core.mail.backends.console.EmailBackend
# PALA_EMAIL_BACKEND=
